{
  "name": "chat-timeline",
  "displayName": "Chat Timeline",
  "description": "A session timeline / semantic minimap for GitHub Copilot Chat: browse, locate and revisit every question/answer turn as clickable timeline nodes.",
  "version": "0.2.0",
  "publisher": "vibe-prompts",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "keywords": [
    "copilot",
    "chat",
    "timeline",
    "history",
    "minimap"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "chatTimeline",
          "title": "Chat Timeline",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "chatTimeline": [
        {
          "type": "webview",
          "id": "chatTimeline.view",
          "name": "Timeline"
        }
      ]
    },
    "commands": [
      {
        "command": "chatTimeline.refresh",
        "title": "Chat Timeline: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "chatTimeline.toggleLayout",
        "title": "Chat Timeline: Toggle Layout (Detail / Compact)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "chatTimeline.refresh",
          "when": "view == chatTimeline.view",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Chat Timeline",
      "properties": {
        "chatTimeline.layout": {
          "type": "string",
          "enum": [
            "detail",
            "compact"
          ],
          "default": "detail",
          "description": "Detail layout: node list + detail pane (detail) or summary rows only (compact)."
        },
        "chatTimeline.source": {
          "type": "string",
          "enum": [
            "local",
            "participant"
          ],
          "default": "local",
          "description": "Data source: local Copilot Chat session files (local) or the @timeline chat participant (participant, future)."
        },
        "chatTimeline.storagePath": {
          "type": "string",
          "default": "",
          "description": "Portable fallback: manually specify the VS Code 'User/workspaceStorage' directory. Leave empty to auto-locate."
        },
        "chatTimeline.refreshDebounceMs": {
          "type": "number",
          "default": 500,
          "minimum": 0,
          "description": "Debounce window (ms) for auto-refresh when chat session files change."
        },
        "chatTimeline.relativeTime": {
          "type": "boolean",
          "default": true,
          "description": "Show timestamps as relative time (e.g. '5 minutes ago')."
        },
        "chatTimeline.longThreshold": {
          "type": "number",
          "default": 2000,
          "minimum": 1,
          "description": "Character threshold (prompt + response) above which a turn is marked as a long conversation."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "package": "node esbuild.js --production",
    "check-types": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint src --ext ts",
    "test": "node --import tsx --test test/**/*.test.ts",
    "vsix": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.90.0",
    "@typescript-eslint/eslint-plugin": "^7.13.0",
    "@typescript-eslint/parser": "^7.13.0",
    "esbuild": "^0.21.5",
    "eslint": "^8.57.0",
    "tsx": "^4.15.0",
    "typescript": "^5.4.5",
    "@vscode/vsce": "^2.27.0"
  },
  "dependencies": {
    "highlight.js": "^11.9.0",
    "markdown-it": "^14.1.0"
  }
}
